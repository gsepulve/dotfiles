# press ctrl+shift+, to reload config

font-family 		= "CommitMonov3_275_min4_allON_allDEF"
font-size 		= 11.05
# with 192dpi (200%) = 11.05 font-size
# with 240dpi (250%) = 8.84 font-size

window-show-tab-bar 	= never
window-decoration	= none
window-padding-x 	= 0
window-padding-y	= 0
background		= 000000

mouse-scroll-multiplier = precision:24.0,discrete:8.0

